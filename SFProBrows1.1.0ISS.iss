; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!
; Non-commercial use only

#define MyAppName "SFProBrows"
#define MyAppVersion "1.1.0"
#define MyAppPublisher "HfdSwimmingTimeHardwareAndSoftwareCorporation"
#define MyAppURL "https://github.com/PyNetCoder/SFProBrows"
#define MyAppExeName "SFProBrows.exe"

[Setup]
AppId={{C3863AD1-24DE-42DA-A95A-0A19DEB377FB}}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={autopf}\{#MyAppName}
UninstallDisplayIcon={app}\{#MyAppExeName}
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
DisableProgramGroupPage=yes
LicenseFile=SourceFiles\LICENSE
PrivilegesRequiredOverridesAllowed=dialog
OutputDir=C:\Users\PC\Desktop
OutputBaseFilename=SFProBrows-1.1.0-InstallerSetup
SetupIconFile=SourceFiles\SFProBrowsInstallerSetupIcon.ico
SolidCompression=yes
WizardStyle=modern dynamic
ChangesAssociations=yes


[Languages]
Name: "en"; MessagesFile: "compiler:Default.isl"
Name: "tr"; MessagesFile: "compiler:Languages\Turkish.isl"
Name: "de"; MessagesFile: "compiler:Languages\German.isl"
Name: "fr"; MessagesFile: "compiler:Languages\French.isl"
Name: "es"; MessagesFile: "compiler:Languages\Spanish.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
; Ana çalıştırılabilir dosya
Source: "SourceFiles\{#MyAppExeName}"; DestDir: "{app}"; Flags: ignoreversion

; Alt klasörler ve bağımlılıklar
Source: "SourceFiles\_internal\*"; DestDir: "{app}\_internal"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "SourceFiles\SfpbNetProj\*"; DestDir: "{app}\SfpbNetProj"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "SourceFiles\extensions\*"; DestDir: "{app}\extensions"; Flags: ignoreversion recursesubdirs createallsubdirs

; Kritik DLL motorları (Güncellemelerde kilitlenmeyi önlemek için restartreplace eklendi)
Source: "SourceFiles\sfpb_core.dll"; DestDir: "{app}"; Flags: ignoreversion restartreplace
Source: "SourceFiles\sfpb_engine.dll"; DestDir: "{app}"; Flags: ignoreversion restartreplace
Source: "SourceFiles\sfpb_net.dll"; DestDir: "{app}"; Flags: ignoreversion restartreplace
Source: "SourceFiles\sfpbNetProj.dll"; DestDir: "{app}"; Flags: ignoreversion restartreplace

; Tarayıcının ana uygulama ikonu ve dokümantasyon
Source: "SourceFiles\SFProBrowsIcon.ico"; DestDir: "{app}"; Flags: ignoreversion
Source: "SourceFiles\CHANGELOG.md"; DestDir: "{app}"; Flags: ignoreversion
Source: "SourceFiles\LICENSE"; DestDir: "{app}"; Flags: ignoreversion
Source: "SourceFiles\README.md"; DestDir: "{app}"; Flags: ignoreversion

; NOT: 'SFProBrows 1.1.0.py' kaynak kodu ve 'SFProBrowsInstallerSetupIcon.ico' 
; kurulum sihirbazı ikonu son kullanıcı güvenliği ve temiz kurulum için buradan kaldırılmıştır.


