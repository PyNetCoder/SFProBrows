[Icons]
; Başlat Menüsü Kısayolu (Güvenli ikon eşlemesi eklendi)
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; IconFilename: "{app}\SFProBrowsIcon.ico"

; Masaüstü Kısayolu (Güvenli ikon eşlemesi eklendi)
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon; IconFilename: "{app}\SFProBrowsIcon.ico"

[Run]
; Kurulum bittiğinde tarayıcıyı çalıştırma seçeneği (%100 dil uyumlu)
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent
