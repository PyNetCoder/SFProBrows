Windows Registry Editor Version 5.00

; 1. Uygulamanın Windows Tarafından Tanınması
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths\SFProBrows.exe]
@="C:\\Program Files\\SFProBrows\\SFProBrows.exe"
"Path"="C:\\Program Files\\SFProBrows\\"

; 2. Kayıtlı Uygulamalar Arasına Ekleme
[HKEY_LOCAL_MACHINE\SOFTWARE\RegisteredApplications]
"SFProBrows"="SOFTWARE\\SFProBrows\\Capabilities"

; 3. SFProBrows Yetenekleri ve Uygulama İkonu
[HKEY_LOCAL_MACHINE\SOFTWARE\SFProBrows\Capabilities]
"ApplicationName"="SFProBrows"
"ApplicationDescription"="HfdSwimmingTimeHardwareAndSoftwareCorporation tarafindan gelistirilen yuksek performansli web tarayici."
"ApplicationIcon"="C:\\Program Files\\SFProBrows\\SFProBrowsIcon.ico,0"

[HKEY_LOCAL_MACHINE\SOFTWARE\SFProBrows\Capabilities\FileAssociations]
".html"="SFProBrowsHTML"
".htm"="SFProBrowsHTML"

[HKEY_LOCAL_MACHINE\SOFTWARE\SFProBrows\Capabilities\URLAssociations]
"http"="SFProBrowsHTML"
"https"="SFProBrowsHTML"

; 4. Global Sınıf Tanımlamaları (HKLM)
[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\SFProBrowsHTML]
@="SFProBrows HTML Document"
"FriendlyTypeName"="SFProBrows HTML Document"

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\SFProBrowsHTML\DefaultIcon]
@="C:\\Program Files\\SFProBrows\\SFProBrowsIcon.ico,0"

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\SFProBrowsHTML\shell\open\command]
@="\"C:\\Program Files\\SFProBrows\\SFProBrows.exe\" \"%1\""

; 5. Windows 10/11 Ayarlar Menüsünde Görünmesi İçin Kullanıcı İlişkilendirmesi (HKCU)
[HKEY_CURRENT_USER\SOFTWARE\Classes\SFProBrowsHTML]
@="SFProBrows HTML Document"

[HKEY_CURRENT_USER\SOFTWARE\Classes\SFProBrowsHTML\shell\open\command]
@="\"C:\\Program Files\\SFProBrows\\SFProBrows.exe\" \"%1\""